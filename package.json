{
  "name": "@gainium/backtester",
  "version": "1.0.2",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./dist/grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./dist/types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "author": "Maksym Shamko <max.shamko25@gmail.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "dist/**/*",
    "src/**/*",
    "scripts/**/*",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^20.1.4",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-standard": "^5.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "prettier": "^2.8.8",
    "typescript": "^5.8.3",
    "uuid": "^9.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:clean": "rm -rf dist && yarn build",
    "build:watch": "tsc --project tsconfig.json --watch",
    "fullInit": "yarn update:indicators",
    "pull": "git pull origin master",
    "push": "git push origin master",
    "lint": "tsc --project tsconfig.json --noEmit && eslint . --cache",
    "lint:fix": "eslint . --fix",
    "build:indicators": "cd node_modules/@gainium/indicators && npm run build",
    "update:indicators": "export GAINIUM_INDICATORS=@gainium/indicators && yarn remove $GAINIUM_INDICATORS && yarn cache clean $GAINIUM_INDICATORS && rm -rf node_modules/$GAINIUM_INDICATORS && yarn add $GAINIUM_INDICATORS@git+https://github.com/Gainium/indicators.git && export -n GAINIUM_INDICATORS",
    "postinstall": "yarn build:if-needed",
    "build:if-needed": "./scripts/build-if-needed.sh || npm run build",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@gainium/indicators": "git+https://github.com/Gainium/indicators.git",
    "csv-parser": "^3.0.0",
    "external-sorting": "^1.3.1"
  }
}
