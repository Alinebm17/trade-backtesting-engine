{
  "name": "@gainium/backtester",
  "version": "1.4.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./dist/grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./dist/hedge": {
      "types": "./dist/hedge/index.d.ts",
      "default": "./dist/hedge/index.js"
    },
    "./dist/types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    },
    "./dca": {
      "types": "./dist/dca/index.d.ts",
      "default": "./dist/dca/index.js"
    },
    "./hedge": {
      "types": "./dist/hedge/index.d.ts",
      "default": "./dist/hedge/index.js"
    },
    "./grid": {
      "types": "./dist/grid/index.d.ts",
      "default": "./dist/grid/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "default": "./dist/types.js"
    }
  },
  "author": "Maksym Shamko <max.shamko25@gmail.com>",
  "license": "MIT",
  "private": false,
  "files": [
    "dist/**/*",
    "src/**/*",
    "scripts/**/*",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.0",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-unused-imports": "^4.2.0",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:clean": "rm -rf dist && npm run build",
    "build:watch": "tsc --project tsconfig.json --watch",
    "fullInit": "npm run update:indicators",
    "pull": "git pull origin master",
    "push": "git push origin master",
    "lint": "tsc --project tsconfig.json --noEmit && eslint . --cache",
    "lint:fix": "eslint . --fix",
    "build:indicators": "cd node_modules/@gainium/indicators && npm run build",
    "update:indicators": "export GAINIUM_INDICATORS=@gainium/indicators && npm uninstall $GAINIUM_INDICATORS && npm cache clean --force && rm -rf node_modules/$GAINIUM_INDICATORS && npm install $GAINIUM_INDICATORS@git+https://github.com/Gainium/indicators.git && unset GAINIUM_INDICATORS",
    "postinstall": "npm run build:if-needed",
    "build:if-needed": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@gainium/indicators": "github:Gainium/indicators",
    "csv-parser": "^3.2.0",
    "external-sorting": "^1.3.1",
    "uuid": "^13.0.0"
  }
}
